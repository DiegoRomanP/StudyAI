# --- LLM (Anthropic / Claude) --------------------------------------------
# Server fallback after any verified active user credential. Leave empty to use
# demo mode only when there is no active user credential (no tokens spent).
# Set a key to use real Claude models as the server fallback.
ANTHROPIC_API_KEY=
# --- Included free-tier AI (optional) ---------------------------------------
# With a DeepSeek key set, learners who have not connected their own AI still
# get real generation. Keep the real key in the repo-root .env or backend/.env
# (both git-ignored), never here.
DEEPSEEK_API_KEY=
DEFAULT_DEEPSEEK_MODEL=deepseek-flash
# Per-request limits for the free tier (a stalled provider fails fast).
# Plan generations per learner and day on this free AI (their own key is unlimited).
FREE_AI_DAILY_LIMIT=3
# Mensajes diarios del asistente de estudio con la IA gratuita (aparte de los usos de planes)
FREE_AI_ASSISTANT_DAILY_LIMIT=20
DEFAULT_AI_READ_TIMEOUT_SECONDS=60
DEFAULT_AI_TOTAL_BUDGET_SECONDS=120

# Model IDs. Defaults use Claude Opus 4.8 / Haiku 4.5. Cheaper alternatives:
#   claude-sonnet-5 (balanced), claude-haiku-4-5 (fast/cheap).
LLM_MODEL_PLAN=claude-opus-4-8
LLM_MODEL_QUIZ=claude-haiku-4-5
# Generation attempts: each call has a total 10-minute budget. A 429 has its
# own retry budget; quota/saldo exhaustion is never retried.
# Token prices (USD per million: input, output, cached input) copied from the provider's
# official pricing page. Empty = usage is recorded without cost. Example:
# LLM_PRICES_USD_PER_MTOK={"claude-haiku-4-5": [1.0, 5.0, 0.1]}
LLM_MAX_RETRIES=3
LLM_MAX_RATE_LIMIT_RETRIES=6
LLM_TIMEOUT_SECONDS=180
LLM_TOTAL_BUDGET_SECONDS=600
# External credential tests are intentionally faster than plan generation.
# LLM_TEST_MAX_RETRIES means retries after the first attempt.
LLM_TEST_CONNECT_TIMEOUT_SECONDS=5
LLM_TEST_READ_TIMEOUT_SECONDS=30
LLM_TEST_TOTAL_BUDGET_SECONDS=45
LLM_TEST_MAX_RETRIES=1
LLM_TEST_MAX_RATE_LIMIT_RETRIES=1
LLM_REQUEST_PACING_SECONDS=2

# --- Ollama local ----------------------------------------------------------
# This is read by the backend process, not by the browser. In Docker, point it
# at the Ollama host/service reachable from the backend container.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_TOTAL_BUDGET_SECONDS=600
OLLAMA_MAX_RETRIES=1

# --- AI from your terminal (self_hosted only) -----------------------------
# Claude Code, OpenCode, Pi and Codex run on the backend host with your own
# login (subscription or the tool's free models). Sign in once in a terminal;
# a name is looked up on PATH, an absolute path also works.
CLAUDE_CODE_BIN=claude
OPENCODE_BIN=opencode
PI_BIN=pi
CODEX_BIN=codex
HARNESS_TIMEOUT_SECONDS=600
HARNESS_TEST_TIMEOUT_SECONDS=90
HARNESS_DISCOVERY_TIMEOUT_SECONDS=30

# --- Persistence ----------------------------------------------------------
DATABASE_URL=sqlite:///./studyai.db
# Postgres/Supabase (pip install -r requirements-saas.txt): postgresql+psycopg://user:pass@host:5432/postgres
CHROMA_PERSIST_DIR=./storage/chroma
# auto = ChromaDB or in-memory; pgvector = chunks in the Postgres DATABASE_URL
VECTOR_BACKEND=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Storage --------------------------------------------------------------
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25
# Figures kept per PDF (needs pymupdf4llm from requirements-rag.txt); a vision AI describes them.
PDF_MAX_IMAGES=20

# --- App ------------------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-me-in-production
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Study tuning ---------------------------------------------------------
# Ebbinghaus spaced-repetition offsets (days) and session length (minutes).
REVIEW_INTERVALS_DAYS=1,3,7,14,30
SESSION_DURATION_MINUTES=25
