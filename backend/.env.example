# --- LLM (Anthropic / Claude) --------------------------------------------
# Leave empty to run in demo mode with the deterministic mock provider
# (no tokens spent, fully functional). Set a key to use real Claude models.
ANTHROPIC_API_KEY=
# Model IDs. Defaults use Claude Opus 4.8 / Haiku 4.5. Cheaper alternatives:
#   claude-sonnet-5 (balanced), claude-haiku-4-5 (fast/cheap).
LLM_MODEL_PLAN=claude-opus-4-8
LLM_MODEL_QUIZ=claude-haiku-4-5
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# --- Persistence ----------------------------------------------------------
DATABASE_URL=sqlite:///./studyai.db
CHROMA_PERSIST_DIR=./storage/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Storage --------------------------------------------------------------
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# --- App ------------------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-me-in-production
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Study tuning ---------------------------------------------------------
# Ebbinghaus spaced-repetition offsets (days) and session length (minutes).
REVIEW_INTERVALS_DAYS=1,3,7,14,30
SESSION_DURATION_MINUTES=25
