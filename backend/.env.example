# --- LLM (Anthropic / Claude) --------------------------------------------
# Server fallback after any verified active user credential. Leave empty to use
# demo mode only when there is no active user credential (no tokens spent).
# Set a key to use real Claude models as the server fallback.
ANTHROPIC_API_KEY=
# --- Included free-tier AI (optional) ---------------------------------------
# With these set, learners who have not connected their own AI still get real
# generation: NVIDIA first, Google once NVIDIA's free quota is gone. They never
# choose between them. Keep the real keys in .env (git-ignored), never here.
NVIDIA_API_KEY=
GEMINI_API_KEY=
DEFAULT_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
DEFAULT_GEMINI_MODEL=gemma-4-26b-a4b-it
# Per-request limits for these free tiers (a stalled tier hands over quickly).
# Plan generations per learner and day on this free AI (their own key is unlimited).
FREE_AI_DAILY_LIMIT=3
DEFAULT_AI_READ_TIMEOUT_SECONDS=60
DEFAULT_AI_TOTAL_BUDGET_SECONDS=120

# Model IDs. Defaults use Claude Opus 4.8 / Haiku 4.5. Cheaper alternatives:
#   claude-sonnet-5 (balanced), claude-haiku-4-5 (fast/cheap).
LLM_MODEL_PLAN=claude-opus-4-8
LLM_MODEL_QUIZ=claude-haiku-4-5
# Generation attempts: each call has a total 10-minute budget. A 429 has its
# own retry budget; quota/saldo exhaustion is never retried.
LLM_MAX_RETRIES=3
LLM_MAX_RATE_LIMIT_RETRIES=6
LLM_TIMEOUT_SECONDS=180
LLM_TOTAL_BUDGET_SECONDS=600
# External credential tests are intentionally faster than plan generation.
# LLM_TEST_MAX_RETRIES means retries after the first attempt.
LLM_TEST_CONNECT_TIMEOUT_SECONDS=5
LLM_TEST_READ_TIMEOUT_SECONDS=30
LLM_TEST_TOTAL_BUDGET_SECONDS=45
LLM_TEST_MAX_RETRIES=1
LLM_TEST_MAX_RATE_LIMIT_RETRIES=1
LLM_REQUEST_PACING_SECONDS=2

# --- Ollama local ----------------------------------------------------------
# This is read by the backend process, not by the browser. In Docker, point it
# at the Ollama host/service reachable from the backend container.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_TOTAL_BUDGET_SECONDS=600
OLLAMA_MAX_RETRIES=1

# --- Persistence ----------------------------------------------------------
DATABASE_URL=sqlite:///./studyai.db
CHROMA_PERSIST_DIR=./storage/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Storage --------------------------------------------------------------
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# --- App ------------------------------------------------------------------
APP_ENV=development
SECRET_KEY=change-me-in-production
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- Study tuning ---------------------------------------------------------
# Ebbinghaus spaced-repetition offsets (days) and session length (minutes).
REVIEW_INTERVALS_DAYS=1,3,7,14,30
SESSION_DURATION_MINUTES=25
