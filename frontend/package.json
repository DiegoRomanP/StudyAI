{
  "name": "studyai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-qa.mjs e2e",
    "test:api": "node scripts/run-qa.mjs api",
    "test:qa": "node scripts/run-qa.mjs all",
    "test:qa:types": "tsc --noEmit -p tsconfig.qa.json",
    "test:qa:runner": "node --test scripts/run-qa.test.mjs scripts/qa-runtime.test.mjs scripts/bruno-smoke.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "axios": "^1.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.24.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@playwright/test": "1.62.1",
    "@usebruno/cli": "4.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
