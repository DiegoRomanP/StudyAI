meta {
  name: Submit the generated quiz exactly once
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/quizzes/{{quizId}}/submit
  body: json
}

script:pre-request {
  const answers = bru.getVar("quizAnswers");
  if (!Array.isArray(answers) || answers.length === 0) {
    bru.runner.stopExecution();
    throw new Error("Quiz submission requires the answer DTOs returned from the quiz request.");
  }
  req.setBody({ answers });
}

body:json {
  {}
}

assert {
  res.status: eq 200
  res.body.total: gt 0
  res.body.score: isDefined
}

tests {
  test("quiz submission returns a valid result for every multiple-choice answer", function() {
    expect(Number.isSafeInteger(res.body.correct)).to.equal(true);
    expect(Number.isSafeInteger(res.body.total)).to.equal(true);
    expect(res.body.correct).to.equal(res.body.total);
    expect(res.body.score).to.equal(100);
    expect(Object.keys(res.body.detail)).to.have.lengthOf(bru.getVar("quizAnswers").length);
  });
}
