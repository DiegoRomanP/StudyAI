meta {
  name: Create an isolated learning goal
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/goals
  body: json
}

script:pre-request {
  const title = `A04 HTTP smoke ${Date.now()}`;
  bru.setVar("goalTitle", title);
  req.setBody({
    goal_type: "LEARNING",
    title,
    description: "Meta sintética creada por el smoke HTTP de A04.",
  });
}

body:json {
  {}
}

assert {
  res.status: eq 201
  res.body.goal_type: eq "LEARNING"
  res.body.id: isDefined
}

tests {
  test("goal creation returns a real ID and the requested title", function() {
    const goal = res.body;
    expect(Number.isSafeInteger(goal.id)).to.equal(true);
    expect(goal.title).to.equal(bru.getVar("goalTitle"));
    expect(goal.description).to.contain("smoke HTTP de A04");
    bru.setVar("goalId", goal.id);
  });
}
