meta {
  name: Poll plan generation to READY
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/plans/{{planId}}/status
}

script:pre-request {
  const timeoutMs = Number(bru.getEnvVar("requestTimeoutMs"));
  if (!Number.isSafeInteger(timeoutMs) || timeoutMs <= 0) {
    bru.runner.stopExecution();
    throw new Error("Plan polling requires a positive initial request timeout.");
  }
  req.setTimeout(timeoutMs);
}

assert {
  res.status: eq 200
  res.body.id: isDefined
}

tests {
  test("plan generation reaches READY within bounded GET-only polling", async function() {
    const planId = bru.getVar("planId");
    const baseUrl = bru.getEnvVar("baseUrl");
    const intervalMs = Number(bru.getEnvVar("pollIntervalMs"));
    const maxAttempts = Number(bru.getEnvVar("planPollMaxAttempts"));
    const pollTimeoutMs = Number(bru.getEnvVar("planPollTimeoutMs"));
    const timeoutMs = Number(bru.getEnvVar("requestTimeoutMs"));
    if (![intervalMs, maxAttempts, pollTimeoutMs, timeoutMs].every((value) => Number.isSafeInteger(value) && value > 0)) {
      bru.runner.stopExecution();
      throw new Error("Plan polling requires positive integer interval, timeout, and attempt limits.");
    }
    let plan = res.body;
    let attempts = 0;
    const deadline = Date.now() + pollTimeoutMs;

    if (plan.status === "FAILED") {
      bru.runner.stopExecution();
      throw new Error(`Plan ${planId} generation FAILED: ${plan.error_message || "no detail"}`);
    }

    try {
      while (plan.status !== "READY" && attempts < maxAttempts && Date.now() < deadline) {
        const remainingMs = deadline - Date.now();
        if (remainingMs <= 0) break;
        await bru.sleep(Math.min(intervalMs, remainingMs));
        const requestBudgetMs = deadline - Date.now();
        if (requestBudgetMs <= 0) break;
        const response = await bru.sendRequest({
          method: "GET",
          url: `${baseUrl}/plans/${planId}/status`,
          timeout: Math.min(timeoutMs, requestBudgetMs),
        });
        expect(response.status).to.equal(200);
        expect(response.data.id).to.equal(planId);
        plan = response.data;
        attempts += 1;

        if (plan.status === "FAILED") {
          bru.runner.stopExecution();
          throw new Error(`Plan ${planId} generation FAILED: ${plan.error_message || "no detail"}`);
        }
      }
    } catch (error) {
      bru.runner.stopExecution();
      throw error;
    }

    if (plan.status !== "READY") {
      bru.runner.stopExecution();
      throw new Error(`Plan ${planId} did not reach READY after ${attempts}/${maxAttempts} GET polls within ${pollTimeoutMs}ms (timeout).`);
    }
    expect(plan.error_message).to.equal("");
    expect(plan.status).to.equal("READY");
  });
}
