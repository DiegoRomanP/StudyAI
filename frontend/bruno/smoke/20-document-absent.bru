meta {
  name: Confirm the document is absent after deletion
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/documents/{{documentId}}
}

assert {
  res.status: eq 404
  res.body.detail: isDefined
}

tests {
  test("deleted document lookup returns the expected not-found content", function() {
    expect(res.status).to.equal(404);
    expect(res.body.detail).to.be.a("string").and.not.empty;
  });
}
