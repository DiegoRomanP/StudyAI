meta {
  name: Upload the canonical A04 Markdown fixture
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/documents/upload
  body: multipartForm
}

body:multipart-form {
  file: @file(../qa/fixtures/studyai-a04-smoke.md) @contentType(text/markdown)
}

assert {
  res.status: eq 201
  res.body.file_type: eq "md"
  res.body.filename: eq "studyai-a04-smoke.md"
  res.body.id: isDefined
}

tests {
  test("upload returns a newly-created document ID and indexing state", function() {
    const document = res.body;
    expect(Number.isSafeInteger(document.id)).to.equal(true);
    expect(document.file_size).to.be.above(0);
    expect(document.status).to.be.oneOf(["PENDING", "INDEXED"]);
    bru.setVar("documentId", document.id);
  });
}
