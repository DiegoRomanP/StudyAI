meta {
  name: Delete the uploaded document
  type: http
  seq: 19
}

delete {
  url: {{baseUrl}}/documents/{{documentId}}
}

assert {
  res.status: eq 204
}

tests {
  test("document cleanup returns 204 with no response content", function() {
    expect(res.status).to.equal(204);
    expect(res.body === undefined || res.body === null || res.body === "").to.equal(true);
  });
}
