meta {
  name: Confirm the goal is absent after deletion
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/goals/{{goalId}}
}

assert {
  res.status: eq 404
  res.body.detail: isDefined
}

tests {
  test("deleted goal lookup returns the expected not-found content", function() {
    expect(res.status).to.equal(404);
    expect(res.body.detail).to.be.a("string").and.not.empty;
  });
}
