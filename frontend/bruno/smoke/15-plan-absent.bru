meta {
  name: Confirm the plan is absent after deletion
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/plans/{{planId}}
}

assert {
  res.status: eq 404
  res.body.detail: isDefined
}

tests {
  test("deleted plan lookup returns the expected not-found content", function() {
    expect(res.status).to.equal(404);
    expect(res.body.detail).to.be.a("string").and.not.empty;
  });
}
