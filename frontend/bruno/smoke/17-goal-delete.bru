meta {
  name: Delete the created goal
  type: http
  seq: 17
}

delete {
  url: {{baseUrl}}/goals/{{goalId}}
}

assert {
  res.status: eq 204
}

tests {
  test("goal cleanup returns 204 with no response content", function() {
    expect(res.status).to.equal(204);
    expect(res.body === undefined || res.body === null || res.body === "").to.equal(true);
  });
}
